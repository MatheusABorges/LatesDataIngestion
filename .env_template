# ==========================================
# 📂 ENTRADA
# ==========================================
# Pasta com os arquivos .xml exportados do Lattes.
XML_INPUT_FOLDER=./input_files

# ==========================================
# 🧠 MODELO DE IA (EMBEDDINGS)
# ==========================================
# "huggingface_local" é o único provider testado/suportado hoje.
EMBEDDING_PROVIDER=huggingface_local

# Repo ID do Hugging Face (baixa e cacheia sozinho, ex:
# "intfloat/multilingual-e5-base") OU caminho local já baixado manualmente
# (ex: "./modelos_locais/mpnet-v2" -- ver "Instalação Manual" no README para
# ambientes sem acesso à internet).
#
# CRÍTICO: precisa ser IDÊNTICO ao EMBEDDING__MODEL_NAME configurado no
# agente (LattesRagAgent/.env) -- ver "Modelo de Embeddings" no README deste
# repo para o motivo. Um vetor de consulta gerado por um modelo e comparado
# contra vetores de documento gerados por outro produz busca semântica
# degradada, sem nenhum erro visível.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Necessário apenas se EMBEDDING_PROVIDER for um provider pago.
EMBEDDING_API_KEY=

# Prefixo literal exigido por alguns modelos assimétricos (convenção E5, ex:
# intfloat/multilingual-e5-*) -- precisa bater com o prefixo do lado QUERY
# configurado no agente (EMBEDDING__QUERY_PREFIX). Vazio: o modelo padrão
# acima é simétrico, não precisa disso.
EMBEDDING_PREFIX=

# Alternativa ao prefixo acima: nome de prompt nomeado do sentence-transformers,
# usado por modelos que não seguem a convenção de prefixo literal (ex:
# EmbeddingGemma -> "retrieval_document"). Não usado pelo modelo padrão
# acima -- ver "Modelo de Embeddings" no README.
EMBEDDING_PROMPT_NAME=

# Pasta de cache pro download automático (repo ID do HF Hub). Não usada
# quando EMBEDDING_MODEL_NAME é um caminho local já baixado manualmente.
EMBEDDING_CACHE_FOLDER=./modelos_locais_cache

# "cuda" para GPU NVIDIA (mais rápido) ou "cpu" (compatível universalmente).
HUGGING_FACE_DEVICE=cpu

# ==========================================
# 🗄️ BANCO DE DADOS VETORIAL (QDRANT)
# ==========================================
QDRANT_URL=http://localhost:6333

# Nomes das coleções -- devem bater com VECTOR_STORE__*_COLLECTION_NAME no
# agente (LattesRagAgent/.env).
QDRANT_COL_SUMMARY=researchers_summary
QDRANT_COL_DATA=researchers_data
